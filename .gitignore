# Dependencies
node_modules/

# Build outputs (Story 1.1 scaffold onward)
.next/
out/
.turbo/
dist/
coverage/
*.tsbuildinfo
# Regenerated by Next on every `next dev` / `next build` (Next 16 points it at
# .next/dev/ vs .next/, so it flips with each mode). Next's own template ignores it.
next-env.d.ts

# Benchmark reports (Story 3.7) — `vitest bench --outputJson` writes one per
# workspace and `scripts/check-bench-budget.mjs` reads them. Never committed: a
# committed measurement is a number nobody re-took, and turbo runs `bench` with
# "cache": false precisely so every run measures this tree.
bench-results.json

# Test / e2e artefacts (Story 1.2)
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db

# Per-machine agent session state (never shared)
.claude/scheduled_tasks.lock
