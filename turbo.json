{
  "$schema": "https://turbo.build/schema.json",
  // tsconfig.base.json is extended by every workspace but is not in any task's
  // default input set — without this, editing it returns cache hits and skips
  // every typecheck.
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build:standalone": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_MODE"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:standalone": {
      "cache": false,
      "persistent": true
    },
    // tsc --noEmit per workspace. No ^build: @gol/* export TS source directly
    // (just-in-time packages), so nothing needs building before a typecheck.
    "typecheck": {},
    // Vitest reads workspace source directly — no ^build dependency (repoints the
    // Story 1.1 test task, which rode ^build and ran zero real tests).
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    // e2e builds+serves the export itself and depends on browser binaries and a
    // free port — environment-specific, so never cached.
    "e2e": {
      "cache": false
    },
    // Chromium-only slice of the same suite, for the dev step's local gate
    // (`npm run ci:dev`). The four-browser matrix is CI's job on the PR.
    "e2e:chromium": {
      "cache": false
    },
    // ⚠️ NEVER CACHED, for a reason stronger than e2e's. A cached benchmark does
    // not merely re-run somewhere else — turbo replays the previous run's stdout
    // and its bench-results.json, so `bench:check` gates a number measured on a
    // different tree and reports ">>> FULL TURBO" while measuring nothing. This
    // happened to Story 3.7's own coverage probe while the story was being
    // written. test:coverage stays cached because it is deterministic; a wall
    // clock is not.
    //
    // ⚠️ AND NEVER IN PARALLEL: the root `bench` script passes `--concurrency=1`
    // (Story 3.7 code review). Turbo schedules independent tasks concurrently
    // by default, which would run @gol/simulation's engine bench and apps/web's
    // repaint bench on the same cores at the same time — and `bench:check` SUMS
    // the two. A number taken under a sibling's CPU contention is not the frame
    // NFR-1.1 constrains, least of all on a 4-vCPU runner. (Turbo has no
    // per-task concurrency knob, so the flag lives on the script.)
    "bench": {
      "cache": false
    }
  }
}
